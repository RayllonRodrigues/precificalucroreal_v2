# Public Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DB_MIGRATION_URL=postgresql://postgres:password@host:5432/postgres
MERCADO_PAGO_ACCESS_TOKEN=your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret
# Keep only during a webhook-secret rotation, then remove it
MERCADO_PAGO_WEBHOOK_SECRET_PREVIOUS=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
MERCADO_PAGO_ENVIRONMENT=sandbox

# Canonical public origin used for payment callbacks (HTTPS outside localhost)
APP_URL=https://app.example.com
# Required comma-separated allowlist; include only the authorized deployment origins
APP_URL_ALLOWLIST=https://app.example.com

# Optional hosted signup test. Use a dedicated mailbox you control; never a real account.
HOMOLOGATION_TEST_EMAIL=
HOMOLOGATION_TEST_PASSWORD=
# Optional file containing the actual recovery email link; never commit this file.
HOMOLOGATION_RECOVERY_LINK_FILE=
